# BSC Testnet defaults. The application stays in local demo mode while the
# registry address is empty.
NEXT_PUBLIC_CHAIN_ID=97
NEXT_PUBLIC_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
NEXT_PUBLIC_EXPLORER_URL=https://testnet.bscscan.com
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_USDT_ADDRESS=

# Optional standalone agent/prover service. Leave empty to use Next.js routes.
NEXT_PUBLIC_AGENT_URL=
